# airek.uz — jcode ishonchsiz (untrusted) ijro sandboxi (x86_64)
#
# jcode (video yaratish VA video overlay) shu konteyner ichida to'liq erkin
# ishlaydi: bash, fayl yozish, Puppeteer/Chrome render, ffmpeg montaj — hammasi
# production serverning haqiqiy fayl tizimidan ajratilgan holda.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Node.js 22 + ffmpeg + headless Chrome kutubxonalari + shriftlar + Python3/NumPy
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg ffmpeg fontconfig fonts-liberation fonts-dejavu \
    libasound2t64 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcups2 \
    libdbus-1-3 libdrm2 libgbm1 libgtk-3-0 libnspr4 libnss3 libx11-6 \
    libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 \
    libxrandr2 libxshmfence1 python3 python3-numpy \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g puppeteer-core@23 hyperframes \
    && apt-get purge -y gnupg \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV NODE_PATH=/usr/lib/node_modules

# jcode x86_64 binary'ni image ichiga joylashtirish (launcher .bin ni yonida qidiradi)
COPY jcode /usr/local/bin/jcode
COPY jcode-linux-x86_64.bin /usr/local/bin/jcode-linux-x86_64.bin
RUN chmod +x /usr/local/bin/jcode /usr/local/bin/jcode-linux-x86_64.bin

RUN fc-cache -f

# Root bo'lmagan foydalanuvchi — konteyner ichida ham imtiyoz yo'q
RUN useradd -m -u 10001 sandboxuser
USER sandboxuser
ENV HOME=/home/sandboxuser
WORKDIR /work

ENTRYPOINT ["/usr/local/bin/jcode"]
